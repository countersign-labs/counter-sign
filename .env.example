# ── counter-sign shared ────────────────────────────────────────────────
# Authority key used to sign Countersignatures (base64url-encoded 32-byte
# ed25519 seed). Generate one with: npm run keygen
COUNTERSIGN_AUTHORITY_KEY=
# Stable identity string for the requesting agent (optional).
COUNTERSIGN_AGENT_ID=agent:demo

# ── Telegram adapter ──────────────────────────────────────────────────
# Create a bot with @BotFather, copy the token. Get your chat id by
# messaging the bot and reading getUpdates, or use @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# The approver's own numeric user id (the person who presses the button).
# In a private chat with the bot this equals TELEGRAM_CHAT_ID and can be left
# empty; in a group the chat id is the group's, so set this.
TELEGRAM_APPROVER_ID=
# "poll" (default; works with no public URL) or "webhook".
TELEGRAM_MODE=poll
# Optional: shared secret checked against X-Telegram-Bot-Api-Secret-Token
# when TELEGRAM_MODE=webhook.
TELEGRAM_WEBHOOK_SECRET=

# ── Discord adapter ───────────────────────────────────────────────────
# Create an app at https://discord.com/developers, add a bot, invite it
# with Send Messages permission. Set the Interactions Endpoint URL to
# your public webhook URL (Discord requires HTTPS).
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# The app's "Public Key" from the developer portal (hex), used to verify
# interaction request signatures.
DISCORD_PUBLIC_KEY=
DISCORD_PORT=8790

# ── Slack adapter ─────────────────────────────────────────────────────
# Create an app at https://api.slack.com/apps with chat:write scope,
# enable Interactivity and point the Request URL at your webhook.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# The app's Signing Secret; used to verify Slack request signatures.
SLACK_SIGNING_SECRET=
# Recommended: the App ID (Basic Information) and workspace Team ID. When
# set, button presses from any other app or workspace are refused.
SLACK_APP_ID=
SLACK_TEAM_ID=
# The demo approver's Slack user id (the person who clicks), e.g. U024BE7LH.
SLACK_APPROVER_ID=
SLACK_PORT=8791

# ── WhatsApp adapter (Meta WhatsApp Business Cloud API only) ──────────
# See adapters/README.md for the Meta app + free test-number setup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# The demo's approver: E.164 digits without "+", e.g. 6591234567.
# The demo sends each request to the whatsapp:<number> approvers the
# Intent names (recipientMode "approvers"), so WHATSAPP_TO is not used.
WHATSAPP_APPROVER=
# Your own code: with no recipient mode, every request goes to this number
# (E.164 digits without "+"), as in 0.2.0. Required unless the mode is
# "approvers".
WHATSAPP_TO=
# Optional: "approvers" (send to each whatsapp:<number> approver the Intent
# names) or "single" (send to WHATSAPP_TO, and refuse an Intent whose
# WhatsApp approver is anyone else). Unset: 0.2.0 behaviour.
WHATSAPP_RECIPIENT_MODE=
# Name of your approved template with two quick-reply buttons.
WHATSAPP_TEMPLATE_NAME=countersign_approval
WHATSAPP_TEMPLATE_LANG=en
# Optional: your template's body, if it differs from
# "{{1}} — action: {{2}} ({{3}})"; with enforceLimits, used to check the
# 1,024-character limit.
WHATSAPP_TEMPLATE_BODY=
# Token you choose; echoed back during Meta webhook verification.
WHATSAPP_VERIFY_TOKEN=
# Required: the app secret (App settings → Basic). Every webhook POST's
# X-Hub-Signature-256 is verified against it; the adapter will not start
# without it.
WHATSAPP_APP_SECRET=
# Optional: 1 to only believe webhook changes for WHATSAPP_PHONE_NUMBER_ID.
WHATSAPP_REQUIRE_PHONE_NUMBER_ID=
# Optional: 1 to reply "Decision recorded: …" after each press.
WHATSAPP_CONFIRM_DECISIONS=
WHATSAPP_PORT=8792

# ── Email adapter ─────────────────────────────────────────────────────
# Any SMTP URL nodemailer accepts, e.g. smtp://user:pass@smtp.example.com:587
SMTP_URL=smtp://127.0.0.1:2525
EMAIL_FROM=approvals@countersign.local
EMAIL_TO=you@countersign.local
# Public base URL of the email callback server (serves the confirm page).
EMAIL_CALLBACK_BASE_URL=http://127.0.0.1:8788
EMAIL_PORT=8788
