{
  "name": "@countersignlabs/counter-sign",
  "version": "0.2.0",
  "description": "Open protocol for agent-to-human authorization. An agent signs its intent; a human countersigns it into authority.",
  "license": "Apache-2.0",
  "author": "Haridarman Kumaresan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/countersign-labs/counter-sign.git"
  },
  "homepage": "https://countersignlabs.com",
  "bugs": {
    "url": "https://github.com/countersign-labs/counter-sign/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "agent",
    "authorization",
    "human-in-the-loop",
    "approval",
    "countersign",
    "ed25519",
    "protocol",
    "mcp",
    "a2a",
    "ai-safety"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./adapters/*": "./dist/adapters/*.js"
  },
  "files": [
    "dist",
    "schemas",
    "spec",
    "LICENSE",
    "LICENSE-CC-BY-4.0.txt",
    "NOTICE",
    "README.md",
    "vectors"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test",
    "keygen": "tsx scripts/keygen.ts",
    "approve": "tsx scripts/approve.ts",
    "enroll": "tsx scripts/enroll.ts",
    "gen:payloads": "tsx scripts/gen-payloads.ts",
    "demo:local": "tsx examples/local.ts",
    "demo:quorum": "tsx examples/quorum.ts",
    "demo:email": "tsx examples/email.ts",
    "demo:telegram": "tsx examples/telegram.ts",
    "demo:discord": "tsx examples/discord.ts",
    "demo:slack": "tsx examples/slack.ts",
    "demo:whatsapp": "tsx examples/whatsapp.ts",
    "gen:vectors": "tsx scripts/gen-vectors.ts"
  },
  "dependencies": {
    "nodemailer": "^9.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/nodemailer": "^8.0.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
