# ── Countersign shared ────────────────────────────────────────────────
# Authority key used to sign Countersignatures (base64url-encoded 32-byte
# ed25519 seed). Generate one with: npm run keygen
COUNTERSIGN_AUTHORITY_KEY=
# Stable identity string for the requesting agent (optional).
COUNTERSIGN_AGENT_ID=agent:demo

# ── Telegram adapter ──────────────────────────────────────────────────
# Create a bot with @BotFather, copy the token. Get your chat id by
# messaging the bot and reading getUpdates, or use @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# "poll" (default; works with no public URL) or "webhook".
TELEGRAM_MODE=poll
# Optional: shared secret checked against X-Telegram-Bot-Api-Secret-Token
# when TELEGRAM_MODE=webhook.
TELEGRAM_WEBHOOK_SECRET=

# ── Discord adapter ───────────────────────────────────────────────────
# Create an app at https://discord.com/developers, add a bot, invite it
# with Send Messages permission. Set the Interactions Endpoint URL to
# your public webhook URL (Discord requires HTTPS).
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# The app's "Public Key" from the developer portal (hex), used to verify
# interaction request signatures.
DISCORD_PUBLIC_KEY=
DISCORD_PORT=8790

# ── Slack adapter ─────────────────────────────────────────────────────
# Create an app at https://api.slack.com/apps with chat:write scope,
# enable Interactivity and point the Request URL at your webhook.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# The app's Signing Secret; used to verify Slack request signatures.
SLACK_SIGNING_SECRET=
SLACK_PORT=8791

# ── WhatsApp adapter (Meta WhatsApp Business Cloud API only) ──────────
# See adapters/README.md for the Meta app + free test-number setup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approver's number in E.164 without "+", e.g. 6591234567
WHATSAPP_TO=
# Name of your approved template with two quick-reply buttons.
WHATSAPP_TEMPLATE_NAME=countersign_approval
WHATSAPP_TEMPLATE_LANG=en
# Token you choose; echoed back during Meta webhook verification.
WHATSAPP_VERIFY_TOKEN=
# Optional: app secret to verify X-Hub-Signature-256 on webhooks.
WHATSAPP_APP_SECRET=
WHATSAPP_PORT=8792

# ── Email adapter ─────────────────────────────────────────────────────
# Any SMTP URL nodemailer accepts, e.g. smtp://user:pass@smtp.example.com:587
SMTP_URL=smtp://127.0.0.1:2525
EMAIL_FROM=approvals@countersign.local
EMAIL_TO=you@countersign.local
# Public base URL of the email callback server (serves the confirm page).
EMAIL_CALLBACK_BASE_URL=http://127.0.0.1:8788
EMAIL_PORT=8788
